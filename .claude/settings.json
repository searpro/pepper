{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm run validate-recipes:*)",
      "Bash(npm run inspect-workflow:*)",
      "Bash(npm run convert-template:*)",
      "Bash(node apps/pepper-pro/server/scripts/inspect-workflow.mjs:*)",
      "Bash(python3 -I .claude/skills/session-handoff/transcripts.py:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git rev-list:*)",
      "Bash(uv run deploy/home/launch.py status:*)",
      "Bash(uv run deploy/home/launch.py logs:*)",
      "Bash(uv run deploy/runpod/launch.py status:*)",
      "Bash(uv run deploy/vastai/launch.py status:*)"
    ],
    "deny": [
      "Read(./apps/*/server/data/**)",
      "Read(./data/**)",
      "Read(./node_modules/**)",
      "Read(./apps/*/server/node_modules/**)",
      "Read(./apps/*/web/node_modules/**)",
      "Read(./packages/*/node_modules/**)",
      "Read(./apps/*/server/dist/**)",
      "Read(./packages/*/dist/**)",
      "Read(./apps/*/server/public/**)",
      "Read(./package-lock.json)",
      "Read(./docs/media/**)",
      "Read(./apps/*/server/.env)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./deploy/kaggle/.last-url)",
      "Read(./deploy/kaggle/.env)",
      "Read(./deploy/runpod/.env)",
      "Read(./deploy/vastai/.env)",
      "Read(./deploy/home/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
