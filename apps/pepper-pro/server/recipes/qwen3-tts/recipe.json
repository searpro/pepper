  "params": [
    {
      "name": "text",
      "type": "text",
      "label": "Text",
      "required": true,
      "description": "What is said, exactly as written. In dialogue mode: one \"Role1: line\" per line."
    },
    {
      "name": "voice_ref",
      "type": "audio",
      "label": "Voice to clone",
      "description": "3-15 s of the speaker (clone modes)."
    },
    {
      "name": "voice_text",
      "type": "text",
      "label": "Its transcript",
      "description": "What the reference says: better cloning than without it."
    },
    {
      "name": "voice_refs",
      "type": "audios",
      "label": "Voices (dialogue)",
      "max_items": 4,
      "description": "A clip of each speaker, as Role1, Role2…"
    },
    {
      "name": "voice",
      "type": "text",
      "label": "Voice description",
      "description": "e.g. \"a warm, low male voice, slow and calm\" (design mode)."
    },
    {
      "name": "speaker",
      "type": "enum",
      "label": "Preset voice",
      "default": "Ryan",
      "options": [
        "Aiden",
        "Dylan",
        "Eric",
        "Ono_anna",
        "Ryan",
        "Serena",
        "Sohee",
        "Uncle_fu",
        "Vivian"
      ]
    },
    {
      "name": "style",
      "type": "text",
      "label": "Delivery",
      "description": "e.g. \"whispering, nervous\" (clone and preset modes)."
    },
    {
      "name": "language",
      "type": "enum",
      "label": "Language",
      "default": "Auto",
      "options": [
        "Auto",
        "English",
        "Chinese",
        "Japanese",
        "Korean",
        "French",
        "German",
        "Spanish",
        "Portuguese",
        "Russian",
        "Italian"
      ]
    },
    {
      "name": "seed",
      "type": "seed",
      "label": "Seed",
      "description": "Absent or negative draws one; a take stores it."
    }
  ],
  "workflows": {
    "clone": {
      "file": "clone.json",
      "outputs": [
        {
          "node": "9",
          "kind": "audio"
        }
      ],
      "requires_files": [
        "base-config-json",
