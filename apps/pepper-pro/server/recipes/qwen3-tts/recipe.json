{
  "schema": 1,
  "id": "qwen3-tts",
  "version": 1,
  "kind": "audio",
  "name": "Qwen3-TTS — speech, voice cloning and dialogue",
  "description": "Speech from text in a cloned voice (a few seconds of someone speaking), a voice described in words, one of nine preset voices, or a whole exchange between up to four cloned voices as one track. For dialogue, narration and the driving audio of talking shots.",
  "family": "qwen3-tts",
  "capabilities": [
    "speech",
    "tts",
    "voice-clone",
    "voice-design",
    "dialogue-audio"
  ],
