  "params": [
    {
      "name": "video",
      "type": "video",
      "label": "Take",
      "required": true
    },
    {
      "name": "first_frame",
      "type": "image",
      "label": "First frame",
      "description": "The sharp still the take opened on, at full size: pinned as the refine's first frame, it carries its detail through the clip."
    },
    {
      "name": "denoise",
      "type": "float",
      "label": "Strength",
      "default": 0.3,
      "min": 0.1,
      "max": 0.6,
      "description": "How much is re-rendered: 0.3 keeps motion and lip-sync; higher adds detail and drift."
    },
    {
      "name": "seed",
      "type": "seed",
      "label": "Seed",
      "description": "Absent or negative draws one."
    }
  ],
  "workflows": {
    "main": {
      "file": "workflow.json",
      "bindings": [
        {
          "param": "video",
          "nodes": [
            {
              "node": "1",
              "input": "file"
            }
          ]
        },
        {
          "param": "first_frame",
          "nodes": [
            {
              "node": "32",
              "input": "image"
            }
          ]
        },
        {
          "param": "denoise",
          "node": "44",
          "input": "denoise"
        },
        {
          "param": "seed",
          "node": "46",
          "input": "noise_seed"
        },
        {
          "file": "model",
          "node": "10",
          "input": "unet_name"
        },
        {
          "file": "text_encoder",
          "node": "13",
          "input": "clip_name"
        },
        {
          "file": "video_vae",
          "node": "14",
          "input": "vae_name"
        },
        {
          "file": "audio_vae",
          "node": "15",
          "input": "vae_name"
        },
        {
          "file": "upscaler",
          "node": "16",
          "input": "model_name"
        },
        {
          "file": "cq_lora",
          "node": "11",
          "input": "lora_name"
        },
        {
          "file": "crisp_lora",
          "node": "12",
          "input": "lora_name"
        }
      ],
      "outputs": [
        {
          "node": "52",
          "kind": "video"
        }
      ],
      "bypass": [
        {
          "node": "35",
          "requires": [
            "image"
          ],
          "through": {
            "0": "latent"
          }
        }
      ]
    }
  },
  "modes": {
    "x2": {
      "label": "Refine ×2",
      "description": "Latent upscale to twice the take's size, then refine: for takes rendered at half size.",
      "workflow": "main"
    },
    "same": {
      "label": "Refine at size",
      "description": "A detail pass at the take's own size, for takes already at delivery size.",
      "workflow": "main",
      "set": [
        {
          "node": "20",
          "input": "value",
          "value": 1
        },
        {
          "node": "35",
          "input": "latent",
          "value": [
            "30",
            0
          ]
        }
      ]
    }
  },
  "default_mode": "x2",
  "tiers": [
    "16gb",
    "24gb-64ram",
    "32gb",
    "48gb",
    "96gb"
  ],
  "notes": "Settings from the MiniMax × LTXV low-VRAM workflow (SonicLoops v3): spatial upscaler ×2, 3 steps linear_quadratic at denoise 0.3, CFG 1.1, euler, CQ enhancer 1.0 + Crisp Enhance 0.8, its refine prompts verbatim. Frames are padded to LTX's 1+8k grid and trimmed back, so picture and sound keep their length. On 16 GB it runs as its own job: transformer and encoder together are about 30 GB, which only fits 32 GB of RAM with nothing else loaded."
}
