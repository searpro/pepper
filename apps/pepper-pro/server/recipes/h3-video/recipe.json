      "label": "Last frame",
      "description": "The video ends on this image."
    },
    {
      "name": "audio",
      "type": "audio",
      "label": "Driving audio",
      "description": "A voice or song the video is anchored to; faces lip-sync to it."
    },
    {
      "name": "previous",
      "type": "video",
      "label": "Continue from",
      "description": "A clip to continue: its last second opens this one. Leave first_frame empty."
    },
