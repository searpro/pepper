{
  "schema": 1,
  "id": "h3-master",
  "version": 1,
  "kind": "video",
  "name": "MiniMax H3 — master from latents",
  "description": "Delivers H3 takes at 1920×1088: their saved latents are upscaled 2× by H3's own latent upscaler and re-sampled by H3 at a low denoise, in overlapping 5 s windows, each under the conditioning its take was made with. A run of shots that continue each other is mastered as one piece, so the texture is decided across the joins and there is no seam. Used by projects when a take with latents is mastered.",
  "family": "minimax-h3-master",
  "capabilities": [
    "upscale",
    "finish",
    "joint-master"
  ],
