  "params": [
    {
      "name": "sequence",
      "type": "text",
      "label": "Takes",
      "required": true,
      "description": "The takes to master, one per line, by their names in ComfyUI's output folder, in playing order; each with its .mctx and .cond beside it. Set by projects."
    },
    {
      "name": "scale",
      "type": "float",
      "label": "Scale",
      "default": 2.0,
      "min": 1.25,
      "max": 2.5,
      "description": "How much larger than the takes: 2 turns 960×544 into 1920×1088."
    },
    {
      "name": "denoise",
      "type": "float",
      "label": "Refine strength",
      "default": 0.2,
      "min": 0.05,
      "max": 0.5,
      "description": "How much of the picture H3 draws again. With H3's shift of 12, 0.2 starts at 75% noise: new skin and fabric detail, the same faces and motion. Higher invents more and can change faces."
    },
    {
      "name": "steps",
      "type": "int",
      "label": "Steps",
      "default": 10,
      "min": 4,
      "max": 20
    },
    {
      "name": "seed",
      "type": "seed",
      "label": "Seed"
    }
  ],
