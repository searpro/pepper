  "models": [
    {
      "id": "flux1-schnell-gguf",
      "kind": "image",
      "name": "FLUX.1 schnell (GGUF)",
      "description": "Fast 12B rectified-flow text-to-image model, Apache-2.0. Quantized weights for modest VRAM; needs the CLIP-L and T5-XXL encoders and the FLUX autoencoder.",
      "reference": "https://huggingface.co/black-forest-labs/FLUX.1-schnell",
      "tags": ["flux", "fast", "apache-2.0"],
      "loadMode": "diffusion-model",
      "mode": "image",
      "defaults": {
        "steps": 4,
        "cfg_scale": 1,
        "width": 1024,
        "height": 1024,
        "sampler": "euler"
      },
      "components": [
        {
          "slot": "checkpoint",
          "label": "Diffusion model",
          "description": "Quantized FLUX.1 schnell weights.",
          "required": true,
          "quantizable": true,
          "source": {
            "repo": "city96/FLUX.1-schnell-gguf",
            "extensions": [".gguf"]
          }
        },
        {
          "slot": "vae",
          "label": "Autoencoder",
          "required": true,
          "quantizable": false,
          "source": {
            "repo": "black-forest-labs/FLUX.1-schnell",
            "match": "ae.safetensors",
            "extensions": [".safetensors"]
          }
        },
        {
          "slot": "clip",
          "role": "clip_l",
          "label": "CLIP-L text encoder",
          "required": true,
          "quantizable": false,
          "source": {
            "repo": "comfyanonymous/flux_text_encoders",
            "match": "clip_l",
            "extensions": [".safetensors"]
          }
        },
        {
          "slot": "clip",
          "role": "t5xxl",
          "label": "T5-XXL text encoder",
          "description": "fp8 is half the size of fp16 at a small quality cost.",
          "required": true,
          "quantizable": true,
          "source": {
            "repo": "comfyanonymous/flux_text_encoders",
            "match": "t5xxl",
            "extensions": [".safetensors"]
          }
        }
      ]
    },
