# Pepper configuration.
#
# Copy to `server/.env` and edit — that file is gitignored and is loaded
# automatically by `npm start` and `npm run dev`, both of which run with
# `server/` as their working directory.
#
# Every value below is commented out and shows the built-in default, so an
# empty .env behaves exactly like no .env at all. Uncomment only what you
# actually need to change.

# --- Storage ----------------------------------------------------------------

# Binaries, models, uploads and the database. Mount the persistent volume here.
# The only storage knob that matters: every other persisted path derives from it.
#DATA_DIR=./data

# Generated outputs. Deliberately outside DATA_DIR — they are reproducible and
# would otherwise fill the volume the models live on. Defaults to the OS temp dir.
#OUTPUT_DIR=

# How long an output survives before the sweep removes it. 0 disables the sweep.
#OUTPUT_RETENTION_MS=86400000

# --- Listener ---------------------------------------------------------------

#HOST=0.0.0.0
#PORT=3000

# Per-request ceiling in ms. 0 means none, which synchronous generation needs:
# a large image on CPU can legitimately hold a request open for minutes.
#HTTP_SERVER_TIMEOUT=0

# --- Hardware ---------------------------------------------------------------

# Selects which release assets are installed and which backend flags are passed:
# cpu | cuda | metal | vulkan | rocm. Defaults to metal on macOS, else cpu.
#ACCEL=

# Install missing backend binaries at startup.
#AUTO_INSTALL_BACKENDS=true

# --- Backend release repos --------------------------------------------------
#
# "owner/repo" whose *latest* release is installed, per backend.
#
# NOTE for local development: the default sdcpp repo currently publishes a
# single Linux x64 CUDA prerelease and nothing else, so auto-install finds no
# asset on macOS, Windows, or any non-CUDA Linux. Upstream leejet publishes the
# same commit for every platform and acceleration — see the local .env.
#SDCPP_RELEASE_REPO=searpro/stable-diffusion.cpp
#LLAMACPP_RELEASE_REPO=ggml-org/llama.cpp
#AUDIOCPP_RELEASE_REPO=searpro/audio.cpp
#PYTHON_RELEASE_REPO=comfyanonymous/ComfyUI

# --- Backend ports ----------------------------------------------------------
#
# Loopback only — the app is the public surface. Change these if something else
# on the machine already holds the port.
#LLAMACPP_PORT=8090
#AUDIOCPP_PORT=8091
#PYTHON_PORT=8092

# How long a backend gets to become healthy before it is declared failed.
#BACKEND_STARTUP_TIMEOUT=120000

# --- Timeouts ---------------------------------------------------------------
#
# Ceilings on a single operation, in ms. These are sd-api's working values, so a
# deployment that sets none of them behaves exactly as that POC did.
#SDCPP_TIMEOUT=600000
#SDCPP_VIDEO_TIMEOUT=3600000
#AUDIOCPP_TIMEOUT=300000
#LLAMACPP_TIMEOUT=300000

# --- Concurrency ------------------------------------------------------------

# Simultaneous generations. Each holds a full model in memory, so raising this
# on a single-GPU machine trades throughput for out-of-memory failures.
#MAX_CONCURRENT_JOBS=1

# Simultaneous weight downloads.
#MAX_CONCURRENT_DOWNLOADS=2

# --- Catalogue --------------------------------------------------------------

# The remote model manifest. Point this at a local file server to test a
# catalogue change before publishing it.
#CATALOGUE_URL=https://raw.githubusercontent.com/searpro/pepper-catalogue/main/pepper-catalogue.json

# How often the fetched copy is re-read.
#CATALOGUE_TTL_MS=600000

# --- Credentials ------------------------------------------------------------
#
# Never logged or echoed. HUGGING_FACE_HUB_TOKEN is accepted as an alias.
# Needed for gated repositories — the FLUX.2 autoencoder among them.
#HF_TOKEN=

# Raises the GitHub API rate limit when resolving backend releases. Only needed
# if you hit 403s during auto-install.
#GITHUB_TOKEN=

# --- Logging ----------------------------------------------------------------

# trace | debug | info | warn | error | fatal
#LOG_LEVEL=info
